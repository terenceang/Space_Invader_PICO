; TMDS serialiser for the Waveshare RP2350-PiZero's DVI data lanes.
;
; Trimmed from lib/PicoDVI/software/libdvi/dvi_serialiser.pio: this project
; only ever needs the non-debug single-ended -> differential shifter, so the
; UART-emulation debug variant (DVI_SERIAL_DEBUG) is dropped entirely.

.program dvi_serialiser
.side_set 2 opt
.origin 0

; Single-ended -> differential serial

	out pc, 1     side 0b10
	out pc, 1     side 0b01

% c-sdk {
// pio_gpio_init()/pio_sm_set_*_with_mask64() come from hardware/pio.h,
// already pulled in by this file's own pioasm-generated header.

static inline void dvi_serialiser_program_init(PIO pio, uint sm, uint offset, uint data_pins) {
    // Use the 64-bit pin-mask variants: on RP2350B, TMDS data pins can be
    // >= 32 (GPIO32-39 on this board), and the 32-bit
    // pio_sm_set_pins_with_mask()/pio_sm_set_pindirs_with_mask() only
    // support pins < 32 (see Hardware.md, "RP2350B PIO Requirements for
    // GPIO >= 32").
    pio_sm_set_pins_with_mask64(pio, sm, 2ULL << data_pins, 3ULL << data_pins);
    pio_sm_set_pindirs_with_mask64(pio, sm, ~0ULL, 3ULL << data_pins);
    pio_gpio_init(pio, data_pins);
    pio_gpio_init(pio, data_pins + 1);

    pio_sm_config c = dvi_serialiser_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, data_pins);
    // Autopull, MSB-first, pull threshold 20 bits (2 TMDS symbols/word,
    // 10 bits each - this board always runs DVI_SYMBOLS_PER_WORD == 2).
    sm_config_set_out_shift(&c, true, true, 20);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, false);
}
%}
