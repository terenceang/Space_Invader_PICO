; Standard Philips I2S transmitter for external DACs (MAX98357A/PCM5102/etc).
; 32 BCLK cycles per stereo frame (16 bits x 2 channels).
; Data is shifted out MSB-first while BCLK is low, sampled by DAC on BCLK rising edge.
; LRCLK transitions 1 BCLK cycle before the new channel's MSB.

.program audio_i2s
.side_set 2

              ;        LRCLK
              ;        | BCLK
public entry_point:
bitloop0:
    out pins, 1        side 0b00 ; Shift out Left data (bits 15..1), BCLK=0, LRCLK=0
    jmp x-- bitloop0   side 0b01 ; BCLK=1 (DAC samples bit)
    out pins, 1        side 0b10 ; Shift out Left bit 0 (LSB), BCLK=0, LRCLK=1 (1 cycle early for Right!)
    set x, 14          side 0b11 ; BCLK=1 (DAC samples LSB)

bitloop1:
    out pins, 1        side 0b10 ; Shift out Right data (bits 15..1), BCLK=0, LRCLK=1
    jmp x-- bitloop1   side 0b11 ; BCLK=1 (DAC samples bit)
    out pins, 1        side 0b00 ; Shift out Right bit 0 (LSB), BCLK=0, LRCLK=0 (1 cycle early for Left!)
    set x, 14          side 0b01 ; BCLK=1 (DAC samples LSB)

% c-sdk {
static inline void audio_i2s_program_init(PIO pio, uint sm, uint offset,
                                           uint data_pin, uint clock_pin_base, float clkdiv) {
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clock_pin_base);
    pio_gpio_init(pio, clock_pin_base + 1);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, clock_pin_base, 2, true);

    pio_sm_config c = audio_i2s_program_get_default_config(offset);
    sm_config_set_out_pins(&c, data_pin, 1);
    sm_config_set_sideset_pins(&c, clock_pin_base);
    // Autopull, MSB-first (shift left), 32-bit FIFO word = 2x 16-bit channels
    sm_config_set_out_shift(&c, false, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, clkdiv);
    pio_sm_init(pio, sm, offset, &c);

    // Preload X register with 14 (for 15 iterations in bitloop: MSB + 14 loop bits = 15, then LSB = 16th)
    pio_sm_exec(pio, sm, pio_encode_set(pio_x, 14));
}
%}
